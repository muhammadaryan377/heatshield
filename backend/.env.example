APP_ENV=development
HEATSHIELD_USE_FIXTURES=false
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=heatshield.db

# Live FortyGuard thermal intelligence. Keep this server-side.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_TIMEOUT_SECONDS=30
FORTYGUARD_POLL_INTERVAL_SECONDS=2
FORTYGUARD_MAX_POLL_ATTEMPTS=60
FORTYGUARD_GRANULARITY_METERS=100
FORTYGUARD_RECENT_HOUR_FALLBACKS=3
FORTYGUARD_CACHE_TTL_SECONDS=600
FORTYGUARD_FAILURE_COOLDOWN_SECONDS=900

# Official US National Weather Service fallback for current atmospheric conditions.
NWS_BASE_URL=https://api.weather.gov
NWS_TIMEOUT_SECONDS=12
NWS_USER_AGENT=HeatShield/1.0 (operational heat safety application)

# Screen 3 integration. Keep this server-side.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
